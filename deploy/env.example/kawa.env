# /srv/kawa/env/kawa.env — 全站唯一 env 檔，backend / frontend / database 三個容器共用
# 每個值只在這裡出現一次；改完 `docker compose up -d` 重建生效

# ── 前後端共用 ──
# 至少 32 bytes（後端啟動時會檢查）。產生：openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48

# ── database（postgres 初始化用；既有 dbdata 不吃新值，換密碼要另外 ALTER USER）──
POSTGRES_PASSWORD=change-me

# ── backend ──
# ⚠ 刻意沒有 APP_PORT：backend 監聽的 3000 同時被 nginx 的
#   upstream backend_app（conf.d/02-proxy.conf）與下方 API_URL 寫死，
#   在這裡改只會讓 backend 起在別的 port 而 nginx 照打 3000 → 全站 502。
#   真要換 port 就三處一起改。
# 密碼同 POSTGRES_PASSWORD，改的話兩處一起改
DATABASE_URL=postgres://kawa:change-me@database:5432
# 完整 URL（與 DATABASE_URL 對稱）：要加密碼就 redis://:pw@valkey:6379、要 TLS 就 rediss://
REDIS_URL=redis://valkey:6379
UPLOAD_PATH=/app/uploads
TORRENT_PATH=/app/torrents
TRUST_CF_HEADER=true
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
LINE_CLIENT_SECRET=

# ── frontend ──
# 內網 hostname 是 compose service 名稱（backend），不再是舊的 api-server-axum
API_URL=http://backend:3000
API_PUBLIC_URL=https://api.kawa.homes
WS_URL=wss://api.kawa.homes
# /changelog 的來源 repo（owner/name）。沒設 = fallback kawagami/api-server-axum；
# 商家 instance 設成空字串 = 關閉整頁（共用同一份 image，不該顯示 kawa 的 commit）
#GITHUB_REPO=kawagami/api-server-axum
