# 必填
DATABASE_URL=postgres://kawa:kawa@host.docker.internal:5432
# 至少 32 bytes（後端啟動時會檢查）。產生：openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
# 完整 URL：要加密碼就 redis://:pw@host:6379、要 TLS 就 rediss://
REDIS_URL=redis://host.docker.internal:6379

# 選填（有預設值）
APP_HOST=0.0.0.0
# ⚠ 只對「本機直跑 backend」有意義（例如 3000 被佔）。生產不要設：
#   那邊的 3000 被 nginx upstream 寫死，改了只會 502，見 deploy/env.example/kawa.env
APP_PORT=3000
UPLOAD_PATH=./uploads
TORRENT_PATH=./torrents
# true/1 才信任 CF-Connecting-IP（限流 / 到訪統計的來源 IP 判斷）。
# ⚠ 只有「所有流量都經 Cloudflare」的部署能開，本機直跑保持 false。
TRUST_CF_HEADER=false
# 未設時：release build = `info,tower_http=warn`、debug build（cargo run）= 全 debug。
# 這是 stdout 的 filter，同時是 `logs` 表門檻（app_settings.log_db_level）的天花板。
# ⚠ dotenv 在 tracing 初始化之前載入，所以寫在本檔有效（2026-08-08 起）。
#RUST_LOG=info,tower_http=warn

# OAuth client secret（選填，不填則停用對應登入）
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
LINE_CLIENT_SECRET=
