# 後端 base URL（server-side only）。本地直接打本機 backend；
# 生產是 docker 內網 http://backend:3000（compose service 名，見 deploy/docker-compose.yml）
API_URL=https://api.kawa.homes
# 後端「公開」base URL —— 拼給瀏覽器直接打的連結用（torrent 下載連結）。
# 沒設時 fallback API_URL，本地兩者相同故可省略；生產必須是對外網域。
API_PUBLIC_URL=https://api.kawa.homes
WS_URL=wss://api.kawa.homes
# 與 backend/.env 的 JWT_SECRET 必須一致（生產由 /srv/kawa/env/kawa.env 單一來源餵兩邊）
JWT_SECRET=your-jwt-secret-here

# 選填：/changelog 的資料來源 repo（owner/name）。
# 沒設 = fallback kawagami/api-server-axum；設成空字串 = 關閉整頁（商家 instance 用）。
#GITHUB_REPO=kawagami/api-server-axum
